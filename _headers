# Cloudflare Pages reads this file and applies these headers to every response.
#
# The site loads nothing from anywhere else: no CDN, no font service, no
# analytics. That makes a strict policy safe here, where it would break most
# sites. The only outside origin is Supabase, which serves the signed artwork
# image URLs.
#
# 'unsafe-inline' is needed because the styles and scripts live directly inside
# the HTML files rather than in separate .js and .css files. It still blocks
# script loaded from another domain, which is the attack that matters.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob: https://*.supabase.co; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co
